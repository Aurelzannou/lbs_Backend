# ============================================================
#  LBS production — copier en .env et TOUT renseigner.
#  Ne jamais committer le vrai .env.
# ============================================================

# --- Images (compte / orga GitHub, en minuscules) ---
GHCR_OWNER=aurelzannou
IMAGE_TAG=latest

# --- Domaines ---
APP_DOMAIN=ecole.mondomaine.com
KEYCLOAK_DOMAIN=auth.mondomaine.com
KEYCLOAK_URL=https://auth.mondomaine.com
ACME_EMAIL=admin@mondomaine.com

# --- Keycloak ---
KEYCLOAK_REALM=lbs-realm
KEYCLOAK_CLIENT_ID=lbs-client
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_admin_fort
KC_DB_USER=keycloak
KC_DB_PASSWORD=CHANGE_ME_kc_db

# --- Base de données applicative ---
APP_DB_NAME=lbs_db
APP_DB_USER=lbs_user
APP_DB_PASSWORD=CHANGE_ME_app_db
# 'update' au 1er démarrage (création du schéma), puis passer à 'validate'
DDL_AUTO=update

# --- Super-administrateur (créé au 1er démarrage du backend) ---
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_EMAIL=admin@mondomaine.com
SUPERADMIN_PASSWORD=CHANGE_ME_superadmin_fort

# --- E-mail SMTP (Brevo : smtp-relay.brevo.com / 587) ---
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=xxxxx@smtp-brevo.com
MAIL_PASSWORD=CHANGE_ME_cle_smtp
MAIL_FROM=La Bonne Semence <no-reply@mondomaine.com>

# --- MinIO (stockage fichiers) ---
MINIO_ROOT_USER=lbsminio
MINIO_ROOT_PASSWORD=CHANGE_ME_minio

# --- RabbitMQ ---
RABBITMQ_USER=lbs_user
RABBITMQ_PASSWORD=CHANGE_ME_rabbit
