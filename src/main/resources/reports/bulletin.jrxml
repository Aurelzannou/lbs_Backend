      <staticText><reportElement x="179" y="132" width="55" height="18" forecolor="#FFFFFF"/><textElement textAlignment="Center" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[Interro]]></text></staticText>
      <staticText><reportElement x="234" y="132" width="50" height="18" forecolor="#FFFFFF"/><textElement textAlignment="Center" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[1er Dev]]></text></staticText>
      <staticText><reportElement x="284" y="132" width="50" height="18" forecolor="#FFFFFF"/><textElement textAlignment="Center" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[2e Dev]]></text></staticText>
      <staticText><reportElement x="334" y="132" width="45" height="18" forecolor="#FFFFFF"/><textElement textAlignment="Center" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[Moy]]></text></staticText>
      <staticText><reportElement x="379" y="132" width="55" height="18" forecolor="#FFFFFF"/><textElement textAlignment="Center" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[Moy Coef]]></text></staticText>
      <staticText><reportElement x="434" y="132" width="35" height="18" forecolor="#FFFFFF"/><textElement textAlignment="Center" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[Rang]]></text></staticText>
      <staticText><reportElement x="469" y="132" width="66" height="18" forecolor="#FFFFFF"/><textElement textAlignment="Center" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[Appréciation]]></text></staticText>
