        <textFieldExpression><![CDATA[$P{periodeLibelle}]]></textFieldExpression>
      </textField>

      <line><reportElement x="0" y="82" width="535" height="1" forecolor="#e2e8f0"/></line>

      <staticText>
        <reportElement x="0" y="90" width="80" height="18"/>
        <textElement><font size="9" isBold="true"/></textElement>
        <text><![CDATA[Élève :]]></text>
