        <textElement><font size="9"/></textElement>
        <textFieldExpression><![CDATA[$P{eleveNomComplet}]]></textFieldExpression>
      </textField>

      <staticText>
        <reportElement x="290" y="90" width="60" height="18"/>
        <textElement><font size="9" isBold="true"/></textElement>
        <text><![CDATA[Classe :]]></text>
      </staticText>
      <textField>
        <reportElement x="350" y="90" width="185" height="18"/>
