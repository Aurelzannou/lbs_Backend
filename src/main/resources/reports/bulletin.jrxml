      <textField><reportElement x="434" y="0" width="35" height="15"/><textElement textAlignment="Center" verticalAlignment="Middle"><font size="8"/></textElement><textFieldExpression><![CDATA[$F{rang} != null ? $F{rang} + "e" : "-"]]></textFieldExpression></textField>
      <textField><reportElement x="469" y="0" width="66" height="15"/><textElement textAlignment="Center" verticalAlignment="Middle"><font size="8"/></textElement><textFieldExpression><![CDATA[$F{appreciation} != null ? $F{appreciation} : "-"]]></textFieldExpression></textField>
