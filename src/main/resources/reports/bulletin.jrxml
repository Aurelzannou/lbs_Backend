      <textField><reportElement x="4" y="0" width="140" height="15"/><textElement verticalAlignment="Middle"><font size="8"/></textElement><textFieldExpression><![CDATA[$F{matiereLibelle}]]></textFieldExpression></textField>
      <textField><reportElement x="144" y="0" width="35" height="15"/><textElement textAlignment="Center" verticalAlignment="Middle"><font size="8"/></textElement><textFieldExpression><![CDATA[$F{coefficient} != null ? new java.text.DecimalFormat("0.#").format($F{coefficient}) : "-"]]></textFieldExpression></textField>
      <textField><reportElement x="179" y="0" width="55" height="15"/><textElement textAlignment="Center" verticalAlignment="Middle"><font size="8"/></textElement><textFieldExpression><![CDATA[$F{interrogation} != null ? new java.text.DecimalFormat("0.##").format($F{interrogation}) : "-"]]></textFieldExpression></textField>
